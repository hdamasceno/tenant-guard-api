# Copy to .env for local development: cp .env.example .env
# Every value below is a local placeholder. Never put real credentials in this file.

# Postgres from docker-compose.yml (throwaway local container).
DATABASE_URL=postgresql://tenant_guard:tenant_guard@localhost:5433/tenant_guard

# HMAC key for signing access tokens. Generate your own, e.g.:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

PORT=3000
LOG_REQUESTS=true
